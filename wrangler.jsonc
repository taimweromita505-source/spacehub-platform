{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spacehub-platform",
  "main": "worker.js",
  "compatibility_date": "2026-11-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "SPACEHUB_KV",
      "id": "3452b2de0b77450e8546c8337db54a99"
    }
  ]
}
