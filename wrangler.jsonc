{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spacehub-platform",
  "main": "worker.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "spacehub.win",
      "custom_domain": true
    },
    {
      "pattern": "www.spacehub.win",
      "custom_domain": true
    }
  ],
  "vars": {
    "PAYPAL_BUSINESS_EMAIL": "romitat924@gmail.com",
    "PAYPAL_MODE": "live",
    "ADMIN_USERNAMES": "",
    "GOOGLE_CLIENT_ID": "",
    "STRIPE_PUBLISHABLE_KEY": ""
  },
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "SPACEHUB_KV",
      "id": "3452b2de0b77450e8546c8337db54a99"
    }
  ]
}
